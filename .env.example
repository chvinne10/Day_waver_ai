# Copy to .env before running Docker Compose. Keep .env out of source control.
POSTGRES_DB=dayweave
POSTGRES_USER=dayweave
POSTGRES_PASSWORD=change-this-local-development-password

# Host ports. The startup script finds alternatives if these are occupied.
BACKEND_PORT=8000
FRONTEND_PORT=8080

SESSION_SECONDS=604800

# Frontend build-time API URL for non-Docker Vite development.
VITE_API_URL=http://localhost:8000

# Local backend settings for non-Docker development.
DATABASE_URL=
DAYWEAVE_DB=backend/dayweave.db
# Local API file storage; Docker and Render set this to persistent mounted volumes.
FILE_STORAGE_ROOT=./data/files
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required to encrypt cloud AI keys at rest. Generate one stable key per environment:
# PowerShell: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste it into your ignored local .env. Never commit or rotate it without migrating saved credentials.
AI_CREDENTIAL_ENCRYPTION_KEY=
